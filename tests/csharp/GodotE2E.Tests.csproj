<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GodotE2E.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The C# client is BCL-only and never needs the Godot runtime; the
         analyzer's name-based detection misfires on E2EVector2. -->
    <NoWarn>$(NoWarn);GdUnit0501</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="gdUnit4.api" Version="5.0.0" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
    <PackageReference Include="gdUnit4.analyzers" Version="1.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\addons\gdunit_e2e\csharp\GodotE2E.Client.csproj" />
  </ItemGroup>
</Project>
